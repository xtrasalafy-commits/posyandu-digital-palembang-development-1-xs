# ------------------------------------------------------------
# SUPABASE (Required for production — Auth + Database + Realtime)
# Create a project at https://supabase.com
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

