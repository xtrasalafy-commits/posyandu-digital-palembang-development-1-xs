# ============================================================
# POSYANDU DIGITAL PALEMBANG — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ------------------------------------------------------------
# SERVER-SIDE (untuk Vercel Serverless Functions)
# Set di: Vercel → Settings → Environment Variables
# JANGAN diberi prefix VITE_ agar tidak terekspos di browser!
# ------------------------------------------------------------

# Koneksi Neon PostgreSQL (wajib untuk login & data)
DATABASE_URL=postgresql://user:password@ep-host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret untuk menandatangani session JWT (bebas string acak panjang)
# Wajib supaya session tidak hilang saat server cold-start
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# ------------------------------------------------------------
# CONTOH (Akun demo, dibuat otomatis neon/schema.sql):
#   kader@posyandu.id  / kader123
#   kader2@posyandu.id / kader123
#   bidan@posyandu.id  / bidan123
#   admin@dinkes.id    / admin123
# ------------------------------------------------------------